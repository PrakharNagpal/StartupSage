{
  "name": "StartupSage",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "postCreateCommand": "python -m venv server/.venv && server/.venv/bin/pip install -r server/requirements.txt",
  "forwardPorts": [8000, 5858],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dart-code.dart-code",
        "dart-code.flutter"
      ]
    }
  }
}
